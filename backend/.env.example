# InvestWall backend configuration. Copy to `.env` and adjust.

# --- App ---
APP_NAME=InvestWall
APP_ENV=development
LOG_LEVEL=INFO
API_PREFIX=

# --- Database ---
# Leave DATABASE_URL empty to use the local SQLite fallback (investwall.db).
# For Postgres: postgresql+psycopg://investwall:investwall@localhost:5432/investwall
DATABASE_URL=

# --- Cache ---
# Leave REDIS_URL empty to use an in-process in-memory cache.
REDIS_URL=

# --- Optional model / feature flags (0 = off, 1 = on) ---
# Real transformer text classifiers (needs requirements-optional.txt + downloads)
ENABLE_TRANSFORMERS=0
# Whisper speech-to-text for audio transcript scam analysis
ENABLE_WHISPER=0
# Learned deepfake/AI-image detector (needs requirements-optional.txt + download)
ENABLE_IMAGE_MODEL=0
IMAGE_MODEL=dima806/deepfake_vs_real_image_detection
# QR decoding in images/PDFs (needs pyzbar + zbar shared lib)
ENABLE_QR=0
# Live DNS lookups (SPF/DMARC). Turn off for fully offline runs.
ENABLE_DNS=1

# Model choices (used only when the matching flag above is on)
TRANSFORMER_MODEL=./ml/models/muril-scam-classifier
WHISPER_MODEL=tiny

# Privacy: 0 = do NOT persist raw input previews / sender server-side
# (only scores, evidence reasons, and metadata are stored).
STORE_RAW_CONTENT=1

# --- LLM explanation layer ---
# template (default, no deps) | ollama | hosted
LLM_PROVIDER=template
# For LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:2b
# For LLM_PROVIDER=hosted
HOSTED_LLM_API_KEY=
HOSTED_LLM_MODEL=claude-haiku-4-5-20251001
HOSTED_LLM_BASE_URL=https://api.anthropic.com

# --- Uploads ---
MAX_UPLOAD_MB=50
VIDEO_SAMPLE_FRAMES=16
